# Пользовательская служба audio-censor (user unit: звук PipeWire живёт в сессии пользователя).
#
# Установка:
#   cargo build --release
#   mkdir -p ~/.config/systemd/user
#   cp systemd/audio-censor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now audio-censor.service
#
# Управление: systemctl --user status|stop|restart audio-censor, журнал: journalctl --user -u audio-censor
# Если проект лежит не в ~/git/RustProgs/audio-censor — поправьте WorkingDirectory и ExecStart.

[Unit]
Description=audio-censor: маскирование запрещённых слов в живом звуке
# Устройства PipeWire должны существовать к моменту запуска
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service

[Service]
Type=simple
# Без -c конфиг ищется: ~/.config/audio-censor/config.toml, затем config/default.toml
# от этого каталога; пути внутри конфига (словарь, модель, логи) — от каталога самого конфига
WorkingDirectory=%h/git/RustProgs/audio-censor
# Свой конфиг: добавьте -c config/config.toml
ExecStart=%h/git/RustProgs/audio-censor/target/release/audio-censor
# systemd останавливает службу SIGTERM: демон доигрывает хвост задержки (до delay_ms),
# ждёт опустошения выходного буфера и сохраняет метрики — на это нужно время
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
